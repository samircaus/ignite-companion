# Copy to a private file (never commit it) and run: node --env-file=PATH dist/server.js

# Required
COMPANION_VAULT_PATH=/path/to/your/notes            # Markdown folder (an Obsidian vault works)
COMPANION_API_TOKEN=                                 # 32+ random characters: openssl rand -hex 32
COMPANION_IGNITE_TOKEN_FILE=/path/to/ignite/token.txt

# Ignite sync server
COMPANION_IGNITE_URL=http://127.0.0.1:8787
COMPANION_IGNITE_VAULT_FOLDER=Kindle                 # folder inside the vault for the mirror
COMPANION_IGNITE_OCR_LANGUAGES=en-US                 # e.g. en-US,de-DE

# Writing to the Kindle (notes → notebooks); needs the sync server's data folder for backups
COMPANION_IGNITE_DATA_DIR=
# COMPANION_IGNITE_IMPORT_BIN=~/Library/Application Support/Ignite/bin/ignite-import
# COMPANION_IGNITE_BACKUP_SCRIPT=~/Library/Application Support/Ignite/backup.zsh

# Kindle files, screenshots and logs over Wi-Fi SSH (optional)
COMPANION_KINDLE_HOST=
COMPANION_KINDLE_PORT=2222
COMPANION_KINDLE_KEY=
COMPANION_KINDLE_KNOWN_HOSTS=

# Living Notebooks: AI answers in ink, using the AI tools already signed in on this Mac
# COMPANION_LIVING_IMPORT_BIN=~/Library/Application Support/Ignite Companion/native/ignite-import-living
COMPANION_LIVING_INTERPRETERS=codex,claude           # tried in order; the next answers if one fails
# COMPANION_LIVING_WATCH=off                         # keep the MCP tools, turn off the pen trigger
